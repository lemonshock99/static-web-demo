---
---
<section class="py-20 animate-on-scroll">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold">Let's Work Together</h2>
      <p class="text-lg text-gray-600 mt-2">Have a project in mind? We'd love to hear about it.</p>
    </div>
    <div class="max-w-2xl mx-auto">
      <form class="bg-white p-8 rounded-lg shadow-md">
        <p class="text-center text-sm text-gray-500 mb-6">Note: This is a static form and does not send emails. A backend service is required.</p>
        <div class="mb-4">
          <label for="name" class="block text-gray-700 font-bold mb-2">Name</label>
          <input type="text" id="name" name="name" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent" required>
        </div>
        <div class="mb-4">
          <label for="email" class="block text-gray-700 font-bold mb-2">Email</label>
          <input type="email" id="email" name="email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent" required>
        </div>
        <div class="mb-6">
          <label for="message" class="block text-gray-700 font-bold mb-2">Message</label>
          <textarea id="message" name="message" rows="5" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent" required></textarea>
        </div>
        <div class="text-center">
          <button type="submit" class="bg-accent text-white font-bold py-3 px-8 rounded-lg hover:bg-opacity-90 shadow-md transition-all duration-300">
            Send Message
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
