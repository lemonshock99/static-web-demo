---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
	title="Contact Us - DesignCo"
	description="Get in touch with us for any inquiries or project proposals."
>
  <div class="container mx-auto px-4 py-16">
    <!-- Page Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold">Contact Us</h1>
      <p class="text-lg text-gray-600 mt-2">We're here to help and answer any question you might have.</p>
    </div>

    <!-- Contact Form Section -->
    <ContactForm />

    <!-- Map and Address Section -->
    <section class="mt-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-2xl font-bold mb-4">Our Office</h3>
          <p class="text-gray-700 mb-2">123 Design Lane</p>
          <p class="text-gray-700 mb-2">Suite 100, Metropolis, 12345</p>
          <p class="text-gray-700">Email: contact@designco.com</p>
        </div>
        <div class="h-96 bg-gray-light rounded-lg shadow-lg flex items-center justify-center">
          <span class="text-gray-400">Google Maps Placeholder</span>
        </div>
      </div>
    </section>
  </div>
</Layout>
